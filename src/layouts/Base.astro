---
// brand.css must load first: it defines the tokens global.css consumes.
// It is vendored from redfearn-group/redfearn-brand and CI fails on drift.
import "../styles/brand.css";
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="en" class="app-layer">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Garage Log</title>
    <link rel="icon" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header no-print">
      <div class="container">
        <h1>
          <a href={withBase("/")} class="site-brand">
            <img src={withBase("/logo-wide-dark.svg")} alt="Redfearn Group" width="305" height="50" />
            <span class="site-brand__app">Garage Log</span>
          </a>
        </h1>
        <nav>
          <a href={withBase("/")}>Dashboard</a>
          <a href={withBase("/archive")}>Archive</a>
        </nav>
      </div>
    </header>
    <main class="container" id="main">
      <slot />
    </main>
    <footer class="site-footer no-print">
      <div class="container">
        <a href="https://redfearn.group" class="site-footer__brand" target="_blank" rel="noopener">
          <img src={withBase("/logo-lockup-dark.svg")} alt="Redfearn Group" width="250" height="58" />
        </a>
        <p class="site-footer__meta">
          Part of <a href="https://redfearn.group" target="_blank" rel="noopener">Redfearn Group</a>
        </p>
        <div class="site-footer__bottom">
          <span>REDFEARN GROUP &middot; EST. 2014 &middot; SPANISH FORK, UT</span>
          <span>&copy; {new Date().getFullYear()} Brady Redfearn</span>
        </div>
      </div>
    </footer>
  </body>
</html>
